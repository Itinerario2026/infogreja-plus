# Supabase Configuration
# Seu projeto Supabase:
SUPABASE_URL=https://wxjzewhqbbvvarotpeyg.supabase.co

# Obtenha estas chaves no painel do Supabase:
# Acesse https://supabase.com/dashboard/project/wxjzewhqbbvvarotpeyg/settings/api
# 1. anon / public key (obrigatória para consultas públicas)
SUPABASE_ANON_KEY=sua_anon_key_aqui

# 2. service_role / secret key (recomendada para o backend ter permissão de escrita/leitura total)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# 3. Connection string PostgreSQL (Postgres connection string para migrações e scripts)
DATABASE_URL=postgresql://postgres:[SENHA]@db.wxjzewhqbbvvarotpeyg.supabase.co:5432/postgres

# Segredo da sessão administrativa (qualquer sequência de caracteres segura)
SESSION_SECRET=infogreja_secret_key_production_2026

# Porta local do servidor (opcional, padrão 3001)
PORT=3001
